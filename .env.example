# Copy to .env and fill in. The .env file is gitignored; never commit a key.

# A free key runs the endpoint sweep and the current-snapshot studies.
# The point-in-time history studies need a Pro key (scope pit:asof:bulk), or
# the published 200-firm sample; the README's Install section says where.
# Keys: https://distillmarkets.com/sign-up
DISTILL_API_KEY=your_key_here

DISTILL_API_BASE=https://api.distillmarkets.com

# Where cached API responses and the latency log go. Gitignored.
DISTILL_CACHE_DIR=cache

# Where you unpacked a Stooq daily bundle, if you use the price joins.
# The toolkit never downloads from Stooq; you obtain the files yourself.
# STOOQ_DIR=cache/stooq_us

# Where you put the SEC's free company_tickers.json, if you use the identity
# joins. The toolkit never downloads from sec.gov; you fetch the file yourself.
# docs/data-sources.md carries the one-line fetch.
# SEC_TICKERS=cache/sec/company_tickers.json
